                "chapter": "",
                "chapter_title": "",
                "section": "",
                "subsection": "",
                "heading": "",
                "page_start": 1,
                "page_end": 1
            },
            "text": "No specific fraud indicators (e.g., suspicious transaction patterns, geolocation anomalies) or IoCs are provided in the paper.",
            "embedding": null,
            "embedding_text": null
        },
        {
            "metadata": {
                "chunk_uuid": "43aa220b-af3a-4374-8c1a-cf913bddb071",
